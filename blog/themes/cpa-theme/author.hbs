{{!< default}}

{{#author}}
<section class="author-hero">
  <div class="shell">
    <p class="eyebrow"><a class="section-link" href="/blog">§ <b>Autora</b></a></p>
    <h1 class="author-hero__name">{{name}}</h1>
    {{#if bio}}
      <p class="author-hero__bio">{{bio}}</p>
    {{/if}}
  </div>
</section>
{{/author}}

<section class="post-list">
  <div class="shell">
    {{#if posts}}
      <ul class="post-grid">
        {{#foreach posts}}
          <li class="post-card">
            <a class="post-card__link" href="{{url}}">
              <p class="post-card__meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
              </p>
              <h2 class="post-card__title">{{title}}</h2>
              <p class="post-card__excerpt">{{excerpt words="36"}}</p>
              <span class="post-card__more">ler post →</span>
            </a>
          </li>
        {{/foreach}}
      </ul>

      {{pagination}}
    {{else}}
      <p class="post-empty">Esta autora ainda não publicou.</p>
    {{/if}}
  </div>
</section>
