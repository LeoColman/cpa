# Deploy
STACK_NAME=cpa-blog

# Host do site principal (Caddy roteia /blog* aqui via matcher)
CPA_HOST=coletivopopularautista.com.br

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=

# Email do remetente (Ghost usa em convites e notificações)
MAIL_FROM=blog@coletivopopularautista.com.br

# SMTP transactional via Postal (convite de autor, reset de senha).
# Porta 587 = STARTTLS (não setar "secure"; Nodemailer faz upgrade sozinho).
# Credenciais: painel do Postal → Credentials → tipo SMTP.
MAIL_SMTP_HOST=postal.SEU_DOMINIO
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
